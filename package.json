{
  "name": "menupulse",
  "version": "0.1.0",
  "private": true,
  "description": "Menupulse — menus digitaux pour la restauration hors foyer : Tapsy (bar) et Tableo (restaurant).",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.ts --vite",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "build": "npm run typecheck && vite build && node scripts/check-budget.ts",
    "typecheck": "tsc -p shared && tsc -p client && tsc -p client/src/sw && tsc -p server && tsc -p .",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=.env --test \"test/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.ts",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.ts",
    "account:create": "node --env-file-if-exists=.env scripts/create-account.ts"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "connect-pg-simple": "^10.0.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3"
  }
}
