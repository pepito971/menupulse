# Base PostgreSQL 16 (en local : PostgreSQL natif, pas Docker)
DATABASE_URL=postgres://menupulse:menupulse@localhost:5432/menupulse

# Obligatoire en production (le serveur refuse de démarrer sans) : chaîne aléatoire longue
SESSION_SECRET=

# Origine publique de l'application, sans barre finale. Les requêtes qui modifient des données
# doivent venir de cette origine (vérification de l'en-tête Origin).
APP_ORIGIN=http://localhost:3100

PORT=3100
NODE_ENV=development
